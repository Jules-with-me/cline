# --- KHIZAR WEB SERVER CONFIGS ---
KHIZAR_SERVER_HOST=127.0.0.1
KHIZAR_SERVER_PORT=8787
KHIZAR_JWT_SECRET=your-secure-jwt-secret
KHIZAR_ENCRYPTION_SECRET=your-32-char-encryption-key

# --- GEMINI AI CONFIGURATION ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-preview-03-25
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95

# --- STANDALONE AGENT FALLBACKS ---
KHIZAR_PROVIDER=gemini
KHIZAR_MODEL=gemini-2.5-flash-preview-03-25

# --- AI FEATURES CONFIGURATION ---
AI_AUTO_APPROVE_SAFE_OPERATIONS=true
AI_MAX_FILES_PER_REQUEST=10
AI_MAX_LINES_PER_FILE=500
AI_INCLUDE_EXPLANATIONS=true
AI_REQUIRE_APPROVAL_FOR_WRITES=true

# --- DATABASE (OPTIONAL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/khizar

# --- DIRECTORY PATH CONFS ---
KHIZAR_WORKSPACE_ROOT=workspace
KHIZAR_DATA_DIR=/var/data/khizar
