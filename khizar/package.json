{
  "name": "@khizar/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web/client",
    "apps/web/server"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "bun run --cwd apps/web/server src/server.ts",
    "dev:client": "bun run --cwd apps/web/client dev"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
